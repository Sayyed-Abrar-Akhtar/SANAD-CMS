# AI-Powered CMS Orchestrator - Environment Variables

# ===========================================
# Required: Jules (Google) API
# ===========================================
# Get from: https://jules.google.com -> Settings -> API Keys
JULES_API_KEY=your-jules-api-key-here

# ===========================================
# Required: GitHub API
# ===========================================
# Create a GitHub Personal Access Token with 'repo' scope
# For PR merge/close operations on tenant repositories
GITHUB_TOKEN=your-github-personal-access-token

# ===========================================
# Required: Slack Integration
# ===========================================
# Incoming Webhook URL for posting review notifications to a channel
# Create at: https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Signing Secret for verifying Slack interactive requests (buttons)
# Found in: Slack App -> Basic Information -> App Credentials -> Signing Secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ===========================================
# Required: Vercel Integration
# ===========================================
# Deploy Hook URL for triggering deployments
# Create at: Vercel Project -> Settings -> Git -> Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxx/yyy

# Secret for verifying Vercel deployment webhook signatures
# Generate a random string and set in Vercel Webhook settings
VERCEL_WEBHOOK_SECRET=your-random-webhook-secret-here

# ===========================================
# Optional: LLM Refinement Layer
# ===========================================
# OpenAI API Key (for GPT-4o refinement) - optional, has deterministic fallback
OPENAI_API_KEY=your-openai-api-key

# Anthropic API Key (for Claude refinement) - optional, has deterministic fallback
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# Optional: Application Settings
# ===========================================
# Default monthly limit for new tenants (overridden per-tenant in admin)
DEFAULT_MONTHLY_LIMIT=5

# Node environment
NODE_ENV=development